# ════════════════════════════════════════════════════════════════
# Dynatrace AI Agent — Environment Variables
# Copy to .env and fill in your values.
# ════════════════════════════════════════════════════════════════

# ── Anthropic / Claude ───────────────────────────────────────────
# Required for AI analysis and chat agent.
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=apikey_01Rj2N8SVvo6BePZj99NhmiT

# ── Dynatrace ────────────────────────────────────────────────────
# Set DEMO_MODE=false and fill these to connect to a real tenant.
DEMO_MODE=true

# Your Dynatrace SaaS environment URL
# Example: https://abc12345.live.dynatrace.com
DT_ENV_URL=

# API token — needs these scopes:
#   logs.read   metrics.read   problems.read   events.read
DT_API_TOKEN=

# ── Polling ──────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=30
LOG_LOOKBACK_MINUTES=5

# ── Health Weights (must sum to 1.0) ────────────────────────────
WEIGHT_ERROR_RATE=0.35
WEIGHT_RESPONSE_TIME=0.25
WEIGHT_AVAILABILITY=0.30
WEIGHT_THROUGHPUT=0.10

# ── App ──────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
